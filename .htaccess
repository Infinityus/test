# Block ONLY browser-like requests to API
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Only apply to API routes
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    
    # Check if it's a browser request
    RewriteCond %{HTTP_USER_AGENT} (Mozilla|Chrome|Safari|Opera|MSIE|Edge) [NC]
    RewriteCond %{HTTP_ACCEPT} text/html [NC]
    
    # Return 403 Forbidden
    RewriteRule .* - [F,L]
</IfModule>